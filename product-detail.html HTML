<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Product Detail - ChemiPure</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="assets/css/style.css">
</head>
<body>
    <!-- Same Header as index.html -->

    <div class="container py-5">
        <div class="row">
            <div class="col-md-6">
                <img id="prod-img" class="img-fluid rounded" alt="">
            </div>
            <div class="col-md-6">
                <h2 id="prod-name"></h2>
                <p><strong>CAS Number:</strong> <span id="prod-cas"></span></p>
                <p id="prod-desc"></p>

                <div class="mt-4">
                    <button id="inquiry-btn" class="btn btn-inquiry btn-lg me-3">Add to Inquiry</button>
                    <button id="save-btn" class="btn btn-outline-primary btn-lg">Save for Later</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->

    <script src="assets/js/script.js"></script>
    <script> window.onload = loadProductDetail; </script>
</body>
</html>
